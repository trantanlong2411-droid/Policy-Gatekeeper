{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "policy-gatekeeper",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIT",
        "class_name": "PolicyAudit"
      }
    ]
  },
  "exports": {
    "PolicyAudit": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
